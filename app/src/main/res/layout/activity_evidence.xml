<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F8FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E3A8A"
            android:elevation="4dp"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/menuBtn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="☰"
                    android:textSize="24sp"
                    android:textColor="#FFFFFF"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Evidence Repository"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="🔍"
                    android:textSize="20sp"
                    android:textColor="#FFFFFF"
                    android:gravity="center"/>
            </LinearLayout>

            <!-- Search and Filter -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/searchBar"
                    android:layout_width="0dp"
                    android:layout_height="45dp"
                    android:layout_weight="1"
                    android:background="@drawable/stats_card_bg"
                    android:backgroundTint="#F3F4F6"
                    android:hint="Search records..."
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:textSize="14sp"
                    android:inputType="text"/>

                <ImageView
                    android:id="@+id/filterBtn"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/stats_card_bg"
                    android:backgroundTint="#F3F4F6"
                    android:padding="10dp"
                    android:src="@android:drawable/ic_menu_sort_by_size"
                    android:clickable="true"
                    android:focusable="true"
                    app:tint="#1E3A8A" />
            </LinearLayout>

            <!-- Filter Panel (Initially Hidden) -->
            <LinearLayout
                android:id="@+id/filterPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:visibility="gone">

                <!-- Student/Faculty/Event specific filters will be toggled here -->
                <LinearLayout
                    android:id="@+id/studentFilters"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <CheckBox android:id="@+id/cbYear" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Year" android:textColor="#FFFFFF"/>
                        <Spinner android:id="@+id/spinnerYear" android:layout_width="match_parent" android:layout_height="40dp" android:visibility="gone" android:background="#F3F4F6"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="5dp">
                        <CheckBox android:id="@+id/cbSpec" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Specialization" android:textColor="#FFFFFF"/>
                        <Spinner android:id="@+id/spinnerSpec" android:layout_width="match_parent" android:layout_height="40dp" android:visibility="gone" android:background="#F3F4F6"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/facultyFilters"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <CheckBox android:id="@+id/cbDept" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dept" android:textColor="#FFFFFF"/>
                        <Spinner android:id="@+id/spinnerDept" android:layout_width="match_parent" android:layout_height="40dp" android:visibility="gone" android:background="#F3F4F6"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/eventFilters"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <CheckBox android:id="@+id/cbSortDate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sort Old to New" android:textColor="#FFFFFF"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <CheckBox android:id="@+id/cbEventType" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Type" android:textColor="#FFFFFF"/>
                        <Spinner android:id="@+id/spinnerEventType" android:layout_width="match_parent" android:layout_height="40dp" android:visibility="gone" android:background="#F3F4F6"/>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/currentViewTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="Showing: Students"
            android:textStyle="bold"
            android:textColor="#4B5563"
            android:textSize="14sp"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout
                android:id="@+id/listContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
            </LinearLayout>
        </ScrollView>

        <!-- Bottom Navigation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:background="#FFFFFF"
            android:elevation="8dp"
            android:orientation="horizontal"
            android:weightSum="3">
            <LinearLayout android:id="@+id/navHome" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏠" android:textSize="20sp" android:textColor="#6B7280"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Home" android:textSize="12sp" android:textColor="#6B7280" android:textStyle="bold"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/navEvidence" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📁" android:textSize="20sp" android:textColor="#1E3A8A"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Evidence" android:textSize="12sp" android:textColor="#1E3A8A" android:textStyle="bold"/>
                <View
                    android:layout_width="40dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="4dp"
                    android:background="#1E3A8A" />
            </LinearLayout>
            <LinearLayout android:id="@+id/navReports" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📊" android:textSize="20sp" android:textColor="#6B7280"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Reports" android:textSize="12sp" android:textColor="#6B7280" android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Navigation Drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select Repository"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#111827"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:id="@+id/navStudents"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="🎓 Student Achievements"
                android:gravity="center_vertical"
                android:textSize="16sp"
                android:textColor="#374151"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"/>

            <TextView
                android:id="@+id/navFaculty"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="👨‍🏫 Faculty Achievements"
                android:gravity="center_vertical"
                android:textSize="16sp"
                android:textColor="#374151"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"/>

            <TextView
                android:id="@+id/navEvents"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="📅 Events &amp; Workshops"
                android:gravity="center_vertical"
                android:textSize="16sp"
                android:textColor="#374151"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"/>

        </LinearLayout>
    </com.google.android.material.navigation.NavigationView>

</androidx.drawerlayout.widget.DrawerLayout>
